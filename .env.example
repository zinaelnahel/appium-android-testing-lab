# Local Appium server
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Target device
APPIUM_PLATFORM=Android
APPIUM_DEVICE_NAME=Android Emulator
# APPIUM_PLATFORM_VERSION=15

# The built-in sample APK is used when APPIUM_APP is not set.
# For your app, set an absolute APK/app path or a remote device-provider app reference.
# APPIUM_APP=/absolute/path/to/your-app.apk

# For an app already installed on Android, omit APPIUM_APP and set:
# APPIUM_APP_PACKAGE=com.example.app
# APPIUM_APP_ACTIVITY=.MainActivity

APPIUM_NO_RESET=false
APPIUM_AUTO_GRANT_PERMISSIONS=true
APPIUM_EXTRA_CAPS={}

# iOS simulator example (requires macOS, Xcode, and the XCUITest driver):
# APPIUM_PLATFORM=iOS
# APPIUM_AUTOMATION_NAME=XCUITest
# APPIUM_DEVICE_NAME=iPhone 16
# APPIUM_APP=/absolute/path/to/YourApp.app
